generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum KnowledgeType {
  technology
  concept
  algorithm
  database
}

enum Relation {
  uses
  related_to
  part_of
  depends_on
  built_with
  extends
}

enum ResourceType {
  article
  video
  documentation
  course
  github
  other
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique

  knowledge   Knowledge[]
  connections Connection[]
  resources   Resource[]
}

model Knowledge {
  id          String        @id @default(uuid())
  userId      String
  title       String
  description String
  type        KnowledgeType
  tags        String[]

  user User @relation(fields: [userId], references: [id])

  SourceConnections Connection[] @relation("SourceConnections")
  TargetConnections Connection[] @relation("TargetConnections")

  resources Resource[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Connection {
  id       String   @id @default(uuid())
  userId   String
  sourceId String
  targetId String
  relation Relation

  user   User      @relation(fields: [userId], references: [id])
  source Knowledge @relation("SourceConnections", fields: [sourceId], references: [id])
  target Knowledge @relation("TargetConnections", fields: [targetId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sourceId, targetId, relation])
}

model Resource {
  id          String       @id @default(uuid())
  userId      String
  knowledgeId String
  title       String
  url         String
  type        ResourceType
  description String

  user      User      @relation(fields: [userId], references: [id])
  knowledge Knowledge @relation(fields: [knowledgeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([knowledgeId])
  @@index(userId)
}
